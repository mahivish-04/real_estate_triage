# Real Estate Triage Agent - Environment Variables
# Copy this file to .env and fill in your API keys.

# LLM Provider: openai | gemini | groq | ollama
LLM_PROVIDER=openai

# OpenAI (when LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-your-openai-key

# Google Gemini (when LLM_PROVIDER=gemini)
GOOGLE_API_KEY=your-google-api-key

# Groq (when LLM_PROVIDER=groq)
GROQ_API_KEY=your-groq-api-key

# Ollama (when LLM_PROVIDER=ollama) - no key needed, uses local endpoint
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# ChromaDB persistence (optional)
CHROMA_PERSIST_DIR=./chroma_db

# Backend API (for Streamlit UI)
API_HOST=0.0.0.0
API_PORT=8000
BACKEND_URL=http://localhost:8000
CHAT_TIMEOUT=60
